#!/usr/bin/env bash
set -euo pipefail

# Prérequis : image shs-payload:3.90.2 construite depuis le dépôt applicatif
# privé et fichier /srv/schoolhomeskills-platform/.env.platform en mode 0600.
docker volume create shs_payload_data >/dev/null
docker run -d \
  --name shs-payload \
  --restart unless-stopped \
  --env-file /srv/schoolhomeskills-platform/.env.platform \
  -e PAYLOAD_BOOTSTRAP_ENABLED=true \
  -e PAYLOAD_DATABASE_URI=file:/data/payload.db \
  -e PAYLOAD_PUBLIC_SERVER_URL=http://127.0.0.1:3001 \
  -v shs_payload_data:/data \
  -p 127.0.0.1:3001:3000 \
  --memory 1073741824 \
  --cpus 1 \
  shs-payload:3.90.2
