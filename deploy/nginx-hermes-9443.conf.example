server {
    listen 9443 ssl;
    listen [::]:9443 ssl;
    server_name vps-f61d79c0.vps.ovh.net;

    ssl_certificate /etc/letsencrypt/live/vps-f61d79c0.vps.ovh.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vps-f61d79c0.vps.ovh.net/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location = /_admin_auth {
        internal;
        proxy_pass http://127.0.0.1:4310/api/auth/admin/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ^~ /api/plugins/ {
        deny all;
    }

    location = /shs-admin-return.css {
        alias /var/www/schoolhomeskills-portal/shs-admin-return.css;
        add_header Cache-Control "public, max-age=300";
    }

    location / {
        auth_request /_admin_auth;
        error_page 401 403 =302 https://$host/connexion-admin?next=hermes;

        proxy_pass http://127.0.0.1:9119;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Accept-Encoding "";
        proxy_connect_timeout 5s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;

        sub_filter_once on;
        sub_filter '</head>' '<link rel="stylesheet" href="/shs-admin-return.css"></head>';
        sub_filter '</body>' '<a id="shs-admin-return" href="https://vps-f61d79c0.vps.ovh.net/administration">← Retour à l’administration</a></body>';
    }
}
